OPENROUTER_API_KEY="your_openrouter_api_key_here"
LANGCHAIN_DEBUG="true"

# Planner / coordinator model
PLANNER_MODEL="openai/gpt-oss-120b"
PLANNER_TEMPERATURE="0.7"        # sampling randomness (higher = more creative)
PLANNER_MAX_TOKENS="900"         # max tokens in the reply
PLANNER_TOP_P="0.9"              # nucleus sampling cutoff (0-1)
PLANNER_PRESENCE_PENALTY="0.3"   # push toward new topics (-2..2)

# Vision model (venue & catering scouts)
VISION_MODEL="google/gemma-4-26b-a4b-it"
VISION_TEMPERATURE="0.3"         # low randomness for consistent judgments
VISION_MAX_TOKENS="500"          # max tokens in the reply
VISION_TOP_P="0.8"               # nucleus sampling cutoff (0-1)
VISION_SEED="42"                 # fixed seed for reproducible comparisons

# Text model (agenda writer)
TEXT_MODEL="poolside/laguna-s-2.1"
TEXT_TEMPERATURE="0.7"           # sampling randomness (higher = more creative)
TEXT_MAX_TOKENS="500"            # max tokens in the reply
TEXT_FREQUENCY_PENALTY="0.4"     # reduce repeated wording (-2..2)

# Why these settings per role?
# - Planner (temp=0.7, top_p=0.9, presence_penalty=0.3):
#   coherent but non-repetitive, varied planning.
# - Vision scouts (temp=0.3, top_p=0.8, seed=42):
#   consistent, comparable, reproducible judgments.
# - Text / agenda writer (temp=0.7, frequency_penalty=0.4):
#   creative, varied wording with less repetition.
# Note: these are inference (sampling) parameters, not weight fine-tuning;
# unset params fall back to the model's own defaults.
